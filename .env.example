# Defina a senha inicial do administrador antes do primeiro uso em uma base vazia.
SANAN_ADMIN_PASSWORD=TroquePorUmaSenhaForte

# Use apenas em recuperacao local consciente.
SANAN_ADMIN_PASSWORD_RESET_ON_START=false
# Supabase (Fase 1 - setup)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SEU_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SEU_SUPABASE_SERVICE_ROLE_KEY
