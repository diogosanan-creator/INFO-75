# Defina a senha do administrador. Em bases existentes, ela sera sincronizada ao reiniciar.
SANAN_ADMIN_PASSWORD=TroquePorUmaSenhaForte

# Use false apenas se quiser manter a senha ja gravada no banco.
SANAN_ADMIN_PASSWORD_RESET_ON_START=true
# Supabase (Fase 1 - setup)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SEU_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SEU_SUPABASE_SERVICE_ROLE_KEY
